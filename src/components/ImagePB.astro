---
import { Picture } from "astro:assets";
import { getFileURL } from "../js/backend.mjs";

// Layouts disponibles pour les images responsives Astro
// @see https://docs.astro.build/fr/reference/modules/astro-assets/#layout
const VALID_LAYOUTS = ["responsive", "fixed", "full-width", "none"];

const {
  record,
  field,
  alt,
  classPicture,
  classImg,
  thumb,
  layout = "full-width",
} = Astro.props;

// Vérifie que le layout est valide, sinon utilise "full-width" par défaut
const resolvedLayout = VALID_LAYOUTS.includes(layout) ? layout : "full-width";

const imageUrl = record && field ? getFileURL(record, field, thumb) : null;
---

{
  imageUrl && (
    <Picture
      pictureAttributes={{ class: classPicture }}
      class={classImg}
      inferSize={true}
      layout={resolvedLayout}
      formats={["avif", "webp"]}
      src={imageUrl}
      alt={alt || ""}
    />
  )
}
